# FRED — free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional public/mobile dashboard URL included in newsletter emails.
# Example on your home Wi-Fi: http://192.168.1.25:8080
DASHBOARD_URL=

# Gmail/SMTP newsletter delivery. For Gmail, create an App Password and use:
# SMTP_ENABLED=1
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USE_SSL=1
# SMTP_STARTTLS=0
# SMTP_USERNAME=yourname@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=yourname@gmail.com
# SMTP_TO=recipient@example.com
SMTP_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_STARTTLS=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Optional threshold overrides: leave unset to use config.yaml defaults.
# Environment overrides YAML; persisted API updates take precedence.
# ALERT_ENABLED=true
# ALERT_Z_THRESHOLD=2.2
# ALERT_WINDOW=180
# ALERT_MIN_HISTORY=20
# ALERT_MIN_STD=0.01
# ALERT_RANGE_ENABLED=true
# ALERT_RANGE_MIN=
# ALERT_RANGE_MAX=
# ALERT_RANGE_MARGIN=1.0
# ALERT_REVERSAL_ENABLED=true
# ALERT_REVERSAL_WINDOW=5
# ALERT_REVERSAL_Z=1.15
# ALERT_TREND_Z=1.15

# POST /api/alerts/config is disabled until a bearer token is configured.
ALERT_CONFIG_TOKEN=
# Optional HTTP(S) webhook. Only environment configuration accepts destinations.
# Immediate alert email delivery uses the SMTP settings above.
ALERT_EMAIL_ENABLED=1
# Independently disable daily newsletters while retaining immediate alerts.
NEWSLETTER_ENABLED=1
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
