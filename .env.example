# FINRA API key (OAuth2 client credentials) for the ATS Transparency weekly
# datasets (ATS_W_FIRM / ATS_W_SMBL / ATS_W_SMBL_FIRM — the dark-pool feed).
# Free at https://gateway.finra.org/app/api-console. Without these, the
# keyless monthly ATS block summary still runs; weekly detail skips cleanly.
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=

# FRED — free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional public/mobile dashboard URL included in newsletter emails.
# Example on your home Wi-Fi: http://192.168.1.25:8080
DASHBOARD_URL=

# Gmail/SMTP newsletter delivery. For Gmail, create an App Password and use:
# SMTP_ENABLED=1
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USE_SSL=1
# SMTP_STARTTLS=0
# SMTP_USERNAME=yourname@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=yourname@gmail.com
# SMTP_TO=recipient@example.com
SMTP_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_STARTTLS=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# In-dashboard analyst chat (Gemini). Get a key at https://aistudio.google.com/
# Powers POST /api/chat and the chat drawer in the terminal UI.
GEMINI_API_KEY=
CHAT_MODEL=gemini-flash-latest
