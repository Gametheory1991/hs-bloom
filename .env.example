# FRED — free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional FRED MCP Streamable HTTP endpoint; blank keeps direct FRED API access.
# Only use a trusted HTTPS server: it receives your FRED API key.
# Loopback HTTP is allowed for local development.
FRED_MCP_URL=
FRED_MCP_OBSERVATIONS_TOOL=get_series_observations
# Optional bearer token for the MCP server, separate from the FRED API key.
FRED_MCP_TOKEN=

# Optional public/mobile dashboard URL included in newsletter emails.
# Example on your home Wi-Fi: http://192.168.1.25:8080
DASHBOARD_URL=

# Gmail/SMTP newsletter delivery. For Gmail, create an App Password and use:
# SMTP_ENABLED=1
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USE_SSL=1
# SMTP_STARTTLS=0
# SMTP_USERNAME=yourname@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=yourname@gmail.com
# SMTP_TO=recipient@example.com
SMTP_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_STARTTLS=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
