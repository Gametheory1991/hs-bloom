  "risk_notes": [
    {
      "id": "gse-conservatorship",
      "source": "FHFA",
      "text": "Fannie Mae and Freddie Mac remain in FHFA conservatorship since September 2008; they trade OTC (FNMA/FMCC). Any recap/release or administrative action is a binary event for agency MBS pricing."
    },
    {
      "id": "mbs-holdings",
      "source": "Federal Reserve H.8",
      "text": "US commercial banks hold roughly $2.7T of agency MBS (Fed H.8) — the single largest private holder class. HTM unrealized losses remain a balance-sheet overhang when rates rise."
    },
    {
      "id": "primary-dealers",
      "source": "Federal Reserve Bank of New York",
      "text": "NY Fed primary dealer roster stands at ~24-26 firms (MUFG Securities Americas added Jan 2026; SMBC Nikko added 2025). Dealers must bid pro-rata in all Treasury auctions and make markets for the Desk."
    },
    {
      "id": "on-rrp-drained",
      "source": "FRED RRPONTSYD",
      "text": "ON RRP facility effectively drained (~$1.5B, Oct 2026) — the money-fund liquidity buffer is gone, so Treasury issuance now draws directly from bank reserves."
    }
  ],
